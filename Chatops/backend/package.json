{
  "name": "chatops-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "npm run check",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "staging:validate": "bash scripts/validate-staging.sh",
    "staging:start": "bash scripts/start-staging.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "^4.0.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.0.0",
    "prisma": "^4.0.0",
    "prom-client": "^15.1.3",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "@types/node": "^18.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
