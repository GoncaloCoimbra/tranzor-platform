NODE_ENV=staging
PORT=3002
WS_PORT=9001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://chatops:replace-with-a-strong-chatops-password@127.0.0.1:5434/chatops_db
REDIS_URL=redis://:replace-with-a-strong-url-safe-redis-password@127.0.0.1:6379
JWT_SECRET=replace-with-a-secure-random-secret
LOGISTICS_URL=http://localhost:3000
LOGISTICS_API_KEY=replace-with-a-valid-logistics-api-key
REDIS_PASSWORD=replace-with-a-strong-url-safe-redis-password
# Optional coturn relay; provision coturn with this shared secret before enabling TURN.
TURN_URLS=
TURN_SHARED_SECRET=
# Example TURN URLs: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
