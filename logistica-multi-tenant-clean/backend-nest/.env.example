SUPER_ADMIN_PASSWORD=change-me
DEMO_ADMIN_PASSWORD=change-me
DEMO_OPERATOR_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me
REDIS_URL=redis://:local-dev-redis-password@localhost:6379
