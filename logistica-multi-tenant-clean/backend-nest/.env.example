# Database
DATABASE_URL=postgresql://postgres:replace-with-a-strong-local-postgres-password@localhost:5432/logistica?schema=public

# JWT
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Cors
CORS_ORIGIN=http://localhost:5173

# Super Admin (seed)
