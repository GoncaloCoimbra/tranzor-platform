{
  "version": "0.1.0",
  "dependencies": {
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/websockets": "^11.1.17",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.59.0",
    "axios": "^1.7.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.556.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-vitals": "^2.1.4"
  },
  "name": "frontend",
  "scripts": {
    "postinstall": "node ../scripts/patch-braces.js",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "generate:api": "kubb generate"
  },
  "private": true,
  "jest": {
    "moduleNameMapper": {
      "^axios$": "<rootDir>/../node_modules/axios/dist/node/axios.cjs",
      "^react-router\\/dom$": "<rootDir>/../node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/../node_modules/react-router/dist/development/index.js",
      "^react-router-dom$": "<rootDir>/../node_modules/react-router-dom/dist/index.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "devDependencies": {
    "@kubb/cli": "^2.23.4",
    "@kubb/core": "^2.23.4",
    "@kubb/plugin-oas": "^2.23.4",
    "@kubb/swagger": "^2.23.4",
    "@kubb/swagger-client": "^2.23.4",
    "@kubb/swagger-ts": "^2.23.4",
    "@kubb/swagger-zod": "^2.23.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "http-proxy-middleware": "^2.0.6",
    "jsdom": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jest-axe": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "brace-expansion@^2.0.1": "^2.1.7",
    "braces": "^3.0.3",
    "ejs": "^3.1.10",
    "micromatch": "^4.0.0",
    "nth-check": "^2.0.1",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5",
    "svgo": "^2.8.4",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1",
    "webpack-dev-middleware": "^5.0.0",
    "ws": "^8.18.0",
    "yaml@2.3.1": "^2.8.3"
  }
}
