# Copy to .env and replace these placeholders before starting Compose. Use unique,
# strong URL-safe credentials; these example values are not deployment secrets.
MONGO_INITDB_DATABASE=Tranzor
MONGODB_ROOT_USERNAME=replace-with-a-mongodb-admin
MONGODB_ROOT_PASSWORD=replace-with-a-strong-url-safe-mongodb-password

# Commerce PostgreSQL
POSTGRES_DB=tranzor
POSTGRES_USER=tranzor_app
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Logistics PostgreSQL
POSTGRES_LOGISTICA_DB=logistica
POSTGRES_LOGISTICA_USER=postgres
POSTGRES_LOGISTICA_PASSWORD=replace-with-a-strong-logistics-postgres-password

# ChatOps PostgreSQL
POSTGRES_CHATOPS_DB=chatops_db
POSTGRES_CHATOPS_USER=chatops
POSTGRES_CHATOPS_PASSWORD=replace-with-a-strong-chatops-postgres-password

# Shared by Commerce, ChatOps and Logistics in the integrated Compose stack
REDIS_PASSWORD=replace-with-a-strong-url-safe-redis-password
TYPESENSE_API_KEY=replace-with-a-strong-typesense-api-key

# Optional ChatOps WebRTC relay. Use a coturn REST shared secret; keep it private.
CHATOPS_TURN_URLS=
CHATOPS_TURN_SHARED_SECRET=
# Example TURN URLs: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349

# ClickHouse
CLICKHOUSE_DB=Tranzor
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-a-strong-clickhouse-password

# Application URLs and persistence
MONGODB_URI=mongodb://replace-with-a-mongodb-admin:replace-with-a-strong-url-safe-mongodb-password@mongo:27017/Tranzor?authSource=admin
DATABASE_URL=postgresql://tranzor_app:replace-with-a-strong-postgres-password@postgres_Tranzor:5432/tranzor
DATABASE_URL_READ_REPLICA=
REDIS_URL=redis://:replace-with-a-strong-url-safe-redis-password@redis:6379
CLICKHOUSE_HTTP_URL=http://clickhouse:8123
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
BACKEND_PORT=3001
FRONTEND_PORT=5173

# Runtime controls
NODE_ENV=development
APP_SHUTDOWN_TIMEOUT_MS=10000
SEED_DATA_PATH=/app/data/product-families.json

# Secrets and crypto
JWT_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret
FIELD_ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-secret
LOGISTICS_API_KEY=replace-with-a-valid-logistics-api-key

# Operational tuning
REDIS_MAX_RETRIES=5
BULK_IMPORT_BATCH_SIZE=250
CACHE_TTL_MS=300000
ALLOW_DEGRADED=false
STARTUP_MAX_ATTEMPTS=5
STARTUP_RETRY_DELAY_MS=250
