{
  "scripts": {
    "install:all": "npm install && npm run chatops:install && npm run logistica:install",
    "commerce:backend:test": "npm test --prefix backend -- --runInBand",
    "commerce:frontend:test": "npm test --prefix frontend",
    "commerce:test": "npm run commerce:backend:test && npm run commerce:frontend:test",
    "chatops:backend:install": "npm install --prefix Chatops/backend",
    "chatops:frontend:install": "npm install --prefix Chatops/frontend",
    "chatops:install": "npm run chatops:backend:install && npm run chatops:frontend:install",
    "chatops:backend:test": "npm test --prefix Chatops/backend",
    "chatops:frontend:test": "npm test --prefix Chatops/frontend",
    "chatops:test": "npm run chatops:backend:test && npm run chatops:frontend:test",
    "logistica:install": "npm install --prefix logistica-multi-tenant-clean",
    "logistica:backend:test": "npm test --prefix logistica-multi-tenant-clean/backend-nest",
    "logistica:frontend:test": "npm test --prefix logistica-multi-tenant-clean/frontend",
    "logistica:test": "npm run logistica:backend:test && npm run logistica:frontend:test",
    "start:all": "node scripts/start-workspace.js",
    "stop:all": "docker compose down",
    "status:all": "docker compose ps",
    "logs:all": "docker compose logs -f",
    "validate:deploy": "docker compose config",
    "start:staging": "docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d",
    "stop:staging": "docker compose -f docker-compose.yml -f docker-compose.staging.yml down",
    "validate:staging": "node scripts/validate-staging.js",
    "deploy:staging": "node scripts/deploy-staging.js",
    "rollback:staging": "node scripts/rollback-staging.js",
    "smoke:check": "node scripts/smoke-check.js",
    "integration:smoke": "node scripts/integration-smoke.js",
    "test:e2e": "npm run test:e2e --prefix backend",
    "test:all": "npm run commerce:test && npm run chatops:test && npm run logistica:test"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8"
  }
}
