# Database and persistence
MONGODB_URI=mongodb://localhost:27017/Tranzor
DATABASE_URL=postgresql://tranzor_app:replace-with-a-strong-postgres-password@localhost:5435/tranzor
DATABASE_URL_READ_REPLICA=

# JWT and secure defaults
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret
JWT_REFRESH_EXPIRE=30d
FIELD_ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-secret

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL and runtime
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=3001

# Cache, queueing and observability
REDIS_URL=redis://:local-dev-redis-password@localhost:6379
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=replace-with-a-strong-typesense-api-key
REDIS_MAX_RETRIES=5
CACHE_TTL_MS=300000
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Operational controls
APP_SHUTDOWN_TIMEOUT_MS=10000
BULK_IMPORT_BATCH_SIZE=250
SEED_DATA_PATH=./data/product-families.json

# Billing integrations
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
