{
	"name": "Tranzor-backend",
	"version": "2.0.0",
	"description": "Production-ready Backend for Tranzor e-commerce platform",
	"main": "dist/server.js",
	"scripts": {
		"start": "node dist/server.js",
		"dev": "ts-node-dev --respawn --transpile-only server.ts",
		"build": "tsc",
		"test": "jest --config jest.config.cjs --coverage",
		"test:watch": "jest --config jest.config.cjs --watch",
		"test:e2e": "npm run db:seed && playwright test",
		"prisma:migrate": "prisma migrate dev --name",
		"prisma:generate": "prisma generate",
		"prisma:seed": "ts-node prisma/seed.ts",
		"db:seed": "ts-node scripts/seed.ts",
		"db:seed:excel": "ts-node scripts/seedExcel.ts",
		"db:rollback": "ts-node scripts/dbRollback.ts",
		"search:reindex": "node scripts/reindex-product-search.js",
		"lint": "eslint \"server/**/*.ts\" --ext .ts",
		"staging:validate": "bash scripts/validate-staging.sh",
		"staging:start": "bash scripts/start-staging.sh"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.76.0",
		"@opentelemetry/exporter-jaeger": "^2.7.1",
		"@opentelemetry/resources": "^2.7.1",
		"@opentelemetry/sdk-trace-node": "^2.7.1",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"@prisma/client": "^5.7.0",
		"@types/cors": "^2.8.19",
		"@types/mongoose": "^5.11.96",
		"@types/winston": "^2.4.4",
		"axios": "^1.16.1",
		"bcryptjs": "^2.4.3",
		"bull": "^4.16.5",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"compression": "^1.8.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"csurf": "^1.11.0",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-async-errors": "^3.1.1",
		"express-rate-limit": "^7.1.5",
		"helmet": "^7.1.0",
		"ioredis": "^5.10.1",
		"jsonwebtoken": "^9.0.0",
		"mongoose": "^9.7.2",
		"morgan": "^1.10.0",
		"multer": "^1.4.5-lts.1",
		"nodemailer": "^10.0.16",
		"opossum": "^9.0.0",
		"pino": "^8.17.2",
		"pino-http": "^8.6.1",
		"prom-client": "^15.1.3",
		"socket.io": "^4.8.1",
		"stripe": "^14.8.0",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"uuid": "^11.1.1",
		"winston": "^3.19.0",
		"xlsx": "^0.18.5",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/bcryptjs": "^2.4.2",
		"@types/compression": "^1.7.5",
		"@types/cookie-parser": "^1.4.7",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/morgan": "^1.9.8",
		"@types/multer": "^1.4.7",
		"@types/node": "^20.10.5",
		"@types/nodemailer": "^8.0.2",
		"@types/opossum": "^8.1.9",
		"@types/supertest": "^7.2.0",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/uuid": "^9.0.7",
		"@typescript-eslint/eslint-plugin": "^6.15.0",
		"@typescript-eslint/parser": "^6.15.0",
		"eslint": "^8.56.0",
		"jest": "^29.7.0",
		"playwright": "^1.62.1",
		"prisma": "^5.7.0",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.9",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.3.3"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"qs": "^6.16.0",
		"uuid": "$uuid"
	}
}
