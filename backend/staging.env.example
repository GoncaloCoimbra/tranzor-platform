NODE_ENV=staging
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/Tranzor
POSTGRES_DB=tranzor
POSTGRES_USER=tranzor_app
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-url-safe-redis-password
DATABASE_URL=postgresql://tranzor_app:replace-with-a-strong-postgres-password@postgres_Tranzor:5432/tranzor
REDIS_URL=redis://:replace-with-a-strong-url-safe-redis-password@redis:6379
CLICKHOUSE_DB=Tranzor
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-a-strong-clickhouse-password
JWT_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret
ALLOW_DEGRADED=false
STARTUP_MAX_ATTEMPTS=5
STARTUP_RETRY_DELAY_MS=250
